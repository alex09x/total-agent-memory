 {
  "key": "code-retry",
  "type": "solution",
  "content": "def retry(fn, attempts=3, base=0.2):\n    for i in range(attempts):\n        try:\n            return fn()\n        except TimeoutError:\n            time.sleep(base * 2 ** i)\n    raise RuntimeError('gave up')\n",
  "project": "billing",
  "context": null,
  "tags": [
   "python",
   "retry"
  ],
  "branch": null,
  "update_of": null,
  "lang": "en"
 },
